# Cloudflare R2 credentials
# Create an API token at: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Optional: override bucket name (default: urantia-data-sources)
# R2_BUCKET_NAME=urantia-data-sources
